# ═══════════════════════════════════════════════════════════════════════════
# AUTO-REELS PRO v10.0 — PRODUCTION ENVIRONMENT CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════
# Copy to .env and fill in your actual values. NEVER commit .env to git.

# ─── ENVIRONMENT ────────────────────────────────────────────────────────────
ENVIRONMENT=production
APP_NAME=AutoReels Pro v10
DEBUG=false
LOG_LEVEL=INFO

# ─── DATABASE (PostgreSQL/Supabase) ──────────────────────────────────────────
POSTGRES_PASSWORD=change_this_to_a_strong_password
DATABASE_URL=postgresql://autoreels:change_this_to_a_strong_password@localhost:5432/autoreels
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ─── REDIS (Cache + Celery Broker) ──────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_TTL=3600

# ─── ANTHROPIC (Claude API) ─────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-v1-...
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_TIMEOUT=120
ANTHROPIC_MAX_TOKENS=1024

# ─── FACEBOOK / INSTAGRAM ───────────────────────────────────────────────────
FB_PAGE_IDS=123456789,987654321
FB_ACCESS_TOKENS={"123456789":"token_here","987654321":"token_here"}
FB_API_VERSION=v18.0
FB_DAILY_LIMIT=5

# ─── TIKTOK ─────────────────────────────────────────────────────────────────
TIKTOK_ACCESS_TOKEN=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_DAILY_LIMIT=3

# ─── INSTAGRAM ───────────────────────────────────────────────────────────────
IG_USER_IDS=
IG_ACCESS_TOKENS={}
IG_DAILY_LIMIT=3

# ─── YOUTUBE SHORTS ─────────────────────────────────────────────────────────
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_DAILY_LIMIT=3

# ─── NOTIFICATIONS ──────────────────────────────────────────────────────────
SLACK_WEBHOOK=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
DISCORD_WEBHOOK=https://discordapp.com/api/webhooks/YOUR/WEBHOOK
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ─── MONITORING ─────────────────────────────────────────────────────────────
SENTRY_DSN=https://your-sentry-dsn
SENTRY_ENV=production
SENTRY_TRACES_RATE=0.1

# ─── FEATURE FLAGS ──────────────────────────────────────────────────────────
DRY_RUN=false
FORCE_RUN=false
NO_WEB=false
DEBUG=false

# ─── PROCESSING ─────────────────────────────────────────────────────────────
VIDEO_CACHE_DIR=/tmp/autoreels-cache
MAX_WORKERS=4

# ─── ADMIN API ───────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_API_KEY=generate_with_python_secrets_token_hex_32

# ─── FACEBOOK PAGE ───────────────────────────────────────────────────────────
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
FB_API_VERSION=v19.0

# ─── ALLOWED ORIGINS (comma-separated for CORS) ──────────────────────────────
ALLOWED_ORIGINS=http://localhost:5000,http://localhost:8000
